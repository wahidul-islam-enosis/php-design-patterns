{
	"name": "wahidul/php-design-pattern-practice",
	"description": "Hands-on design pattern practice using PHP",
	"type": "project",
	"license": "MIT",
	"require": {
		"php": "^8.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^12.0"
	},
	"autoload": {
		"psr-4": {
			"Patterns\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"test:coverage": "phpunit --coverage-text"
	},
	"config": {
		"sort-packages": true
	}
}
